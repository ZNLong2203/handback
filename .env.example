# Copy to .env.local and fill in. Every value here ships empty on purpose.

# ─── PayPal (sandbox) ────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your REST app.
# Bind the app to a US sandbox business account and tick Vault and Payouts.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Returned when you register this app's webhook URL (public HTTPS only).
PAYPAL_WEBHOOK_ID=

# Sandbox personal (buyer) account used by the scripted demo and e2e tests.
# Wrap the password in single quotes if it contains # (sandbox ones often do).
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# ─── AI ──────────────────────────────────────────────────────
# Gemini compares the photos and writes the dispute and schedule messages.
# Without a key, demo mode replays recorded replies for the sample photos.
GEMINI_API_KEY=
# Read only by the assistant demo client (scripts/agent-books.ts).
ANTHROPIC_API_KEY=
# Optional Gemini model override; defaults to gemini-3.8-flash.
AI_MODEL=
# Model for the assistant demo (scripts/agent-books.ts). Defaults to
# claude-opus-5-5 when ANTHROPIC_API_KEY is set, gemini-3.8-flash otherwise.
AGENT_MODEL=

# ─── App ─────────────────────────────────────────────────────
# Public URL of the deployment, used for PayPal return URLs and webhooks.
APP_URL=http://localhost:3000
# Set to true to run without PayPal or AI keys, using recorded fixtures.
DEMO_MODE=
# Shared secret for scheduled jobs (POST /api/jobs/renew-holds and /api/jobs/reset-demo).
CRON_SECRET=
# The counter's shared access code, at least 12 characters. Set it on any copy
# others can reach: /shop, its server actions, /api/live/shop and evidence PDFs
# then need the staff cookie from /shop/sign-in. Empty leaves the counter open
# (local, demo); a shorter code closes it to everyone.
SHOP_ACCESS_CODE=
# Optional server secret mixed into the staff cookie's key (render.yaml
# generates one). Changing it signs everyone out.
STAFF_COOKIE_SECRET=
# How many X-Forwarded-For entries at the end were added by proxies after the
# one that saw the client. 0 (default) takes the last entry. Check the address
# /api/health reports under staffAccess.countedAs after deploying.
TRUSTED_PROXY_HOPS=
# true on a copy shared with hackathon judges: the sign-in page says the code
# is in the Devpost testing instructions.
PUBLIC_DEMO=
# true only on a public demo: once a day POST /api/jobs/reset-demo DELETES
# EVERY RENTAL and seeds the sample ones again (docs/deploy.md). Refused with
# live PayPal. Leave it empty anywhere else.
DEMO_RESET=
# Hour of that reset in UTC, 0 to 23. Empty means 20 (3:00 in Vietnam).
DEMO_RESET_HOUR=
# MCP endpoint the assistant demo connects to. Defaults to $APP_URL/api/mcp.
MCP_URL=

# ─── Render (docs/deploy.md) ─────────────────────────────────
# On Render, render.yaml sets the slug; with an API key, inspections and hold
# renewals run as Render Workflows tasks. Locally, RENDER_USE_LOCAL_DEV=true
# sends them to `render workflows dev` instead. Unset: they run in-process.
RENDER_WORKFLOW_SLUG=
RENDER_API_KEY=
RENDER_USE_LOCAL_DEV=
# Saved sandbox wallet for `npm run seed:demo` in sandbox mode, or "latest".
SEED_VAULT_ID=
